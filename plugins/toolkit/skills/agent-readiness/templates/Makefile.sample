# <PROJECT> — task runner.
# Local dev is isolated (never touches system-wide tooling). The `check` target
# is the single sanctioned gate; run it before every commit. `make help` lists
# everything. Replace the placeholder commands below with your stack's tools.

# Pin the language/runtime version in ONE place so local and CI can't drift.
# (e.g. read from a version file: `$(shell cat .tool-version)`)
# (A comment after a value on the same line becomes part of the value, spaces
# and all — keep comments on their own lines.)
TOOLVER := <pinned-version>
# the isolated environment dir (venv / node_modules / etc.)
ENV     ?= .devenv
# the environment's own binaries
BIN     := $(ENV)/bin

# Use bash and fail loudly.
SHELL := bash
.SHELLFLAGS := -eu -o pipefail -c
.DEFAULT_GOAL := help

# ── Local dev (isolated) ──────────────────────────────────────────────────
$(ENV):                        ## create the isolated environment
	<create isolated environment, e.g. python -m venv $(ENV) / npm ci>

.PHONY: install
install: $(ENV)                ## install runtime + dev deps into the environment
	<install dependencies into $(ENV)>

.PHONY: lock
lock: $(ENV)                   ## freeze exact installed versions for reproducibility
	<write a lockfile of exact versions>
	@echo ">> wrote lockfile"

.PHONY: lint
lint: $(ENV)                   ## lint
	<run the linter, e.g. $(BIN)/ruff check .>

.PHONY: format
format: $(ENV)                 ## auto-format
	<run the formatter>

.PHONY: typecheck
typecheck: $(ENV)              ## static type check
	<run the type checker, e.g. $(BIN)/mypy src/>

.PHONY: test
test: $(ENV)                   ## run tests with coverage (>=80% target)
	<run tests with coverage, e.g. $(BIN)/pytest --cov=src>

# The single sanctioned gate — the loop and every commit run THIS.
# Its gates run IN PARALLEL: they are independent, and the agent runs this at
# least twice per increment, so its wall time is paid on every step. Measured on
# a real project: four tool containers, 26.7 s in sequence. `--output-sync=target`
# keeps each gate's output together; any failing gate still fails `check`, and
# the green line prints only when all passed. --output-sync needs GNU make >= 4.0;
# on older make (macOS ships 3.81) the gates still run in parallel, with their
# output interleaved. A gate that shares mutable state with another (one
# database, one port) belongs in a serial prerequisite chain instead.
CHECK_JOBS ?= 6
OUTPUT_SYNC := $(if $(filter 4.% 5.% 6.%,$(MAKE_VERSION)),--output-sync=target)

.PHONY: check check-gates
check:                          ## lint + typecheck + test, in parallel (run before committing)
	@$(MAKE) --no-print-directory --jobs=$(CHECK_JOBS) $(OUTPUT_SYNC) check-gates
	@echo ">> make check: all gates green"

check-gates: lint typecheck test

.PHONY: clean
clean:                          ## remove the environment and caches
	rm -rf $(ENV) .*_cache .coverage htmlcov

# ── Loop hygiene (control-plane prose budget) ─────────────────────────────
# NOT dependencies of `check` on purpose: `check` is the correctness gate and must
# never fail on prose style. loop/PROMPT.md §5 calls loop-hygiene in the agent's
# own pre-commit sequence, which is what gives the warning a reader.
.PHONY: where
where:                          ## print the loop's position (loop/where.sh --human)
	@./loop/where.sh --human

.PHONY: loop-hygiene
loop-hygiene:                   ## warn if the newest LOG entry / STATE.md / INDEX rows exceed their budgets
	@./loop/entry-size-guard.sh

# make reports any failure of the script as its own exit 2; the loop calls
# loop/step-done.sh directly when it needs the 1 (gate red) / 3 (refused) split.
.PHONY: step-done
step-done:                      ## close a step: gate → LOG evidence → tick → hygiene → scan → commit (MSG=…, PUSH=1)
	@test -n "$(MSG)" || { echo 'usage: make step-done MSG="<type>(<scope>): <subject>" [PUSH=1]' >&2; exit 2; }
	@./loop/step-done.sh --commit "$(MSG)" $(if $(PUSH),--push)

.PHONY: amendments
amendments:                     ## warn which deferred reviewer findings (the PLAN Amendments section) are still open
	@./loop/amendments-guard.sh

# ── Project-specific targets ──────────────────────────────────────────────
# Add run / build / validate / acceptance targets your project needs, e.g.:
# .PHONY: build
# build:                        ## build the artifact / image
# 	<build command>
#
# .PHONY: accept
# accept: $(ENV)                ## run the acceptance check for the gate phase
# 	<command that measures results against the documented thresholds>

.PHONY: help
help:                           ## list targets
	@grep -hE '^[a-zA-Z_-]+:.*## ' $(MAKEFILE_LIST) \
		| awk '{ i = index($$0, "## "); t = substr($$0, 1, index($$0, ":") - 1); \
		         printf "  \033[36m%-16s\033[0m %s\n", t, substr($$0, i + 3) }'
